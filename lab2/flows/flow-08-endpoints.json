        "name": "function 5",
        "func": "const id = msg.req.query.id; // получаем query-параметр ?id=...\n\nif (!id) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Отсутствует параметр id\" };\n} else if (id === \"1\") {\n    msg.statusCode = 200;\n    msg.payload = { id: 1, name: \"Элемент 1\", owner: \"Казак\" };\n} else {\n    msg.statusCode = 404;\n    msg.payload = { error: \"Элемент не найден\" };\n}\n\nreturn msg;",
